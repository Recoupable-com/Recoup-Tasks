# ── Tier 1: Required at runtime ──
# RECOUP_API_KEY is enforced in task/sandbox execution paths
RECOUP_API_KEY=
# RECOUP_API_BASE_URL defaults to https://recoup-api.vercel.app if unset
RECOUP_API_BASE_URL=http://localhost:3000

# ── Tier 2: Feature-specific ──
GITHUB_TOKEN=
FAL_KEY=

# Vercel (sandbox deploys)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_AI_GATEWAY_API_KEY=

# Coding agent
CODING_AGENT_CALLBACK_SECRET=
CODING_AGENT_CALLBACK_URL=
CLAUDE_CODE_OAUTH_TOKEN=
